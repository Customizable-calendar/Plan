# 이 파일을 .env로 복사해서 값을 채워요. .env는 커밋하지 않아요.
# EXPO_PUBLIC_ 로 시작하는 값은 앱 안에 그대로 들어가요. 공개돼도 되는 값만 넣어요.

# Supabase 대시보드 > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
# publishable(또는 anon) 키만. service_role·secret 키는 절대 넣지 않아요.
EXPO_PUBLIC_SUPABASE_KEY=

# 기능 데이터를 어디서 가져올지: fixtures(예시 JSON, M1 기본) | supabase (lib/data-source.ts)
EXPO_PUBLIC_DATA_SOURCE=fixtures

# 파일 저장소 종류 (docs/decisions/0003-file-storage.md)
EXPO_PUBLIC_STORAGE_PROVIDER=supabase

# 구글 OAuth 비밀값처럼 진짜 비밀인 값은 여기가 아니라
# `supabase secrets set` 으로 Edge Functions에만 넣어요.
